# --- Lead intake (server-only) ---------------------------------------------
# Shared key for the /api/quote proxy that forwards leads to the agency
# platform's public lead-intake endpoint.
# Never put a real value here: this repo is public. Production's value lives only
# in the Vercel project env (Production, sensitive) and on ins-platform. Leave it
# blank locally and requests fail closed (the safe default).
LEAD_INTAKE_KEY=

# Origin of the agency platform (ins-platform) that receives leads at
# /api/public/leads. Server-only: never prefix with NEXT_PUBLIC_. Unset or
# blank = https://ins.taboragency.com (PLATFORM_DEFAULT_URL in src/lib/brand.ts).
# Read at runtime (not inlined), but on Vercel a change still needs a redeploy.
# The proxy does NOT follow redirects, so this must be the live host itself —
# a retired host that 301s (e.g. ins.jahdev.com) makes every lead fail with 502.
# INS_PLATFORM_URL=https://ins.taboragency.com

# --- Client portal -----------------------------------------------------------
# Base URL of the agency platform's client portal (same host as lead intake).
# The site appends /portal/login, /portal/request-access, /portal/certificates,
# and the public /coverage-checkup path to this value.
# Inlined at build time — a change needs a redeploy. Unset or blank =
# https://ins.taboragency.com. (portal.taboragency.com is retired; do not use it.)
# NEXT_PUBLIC_PORTAL_URL=https://ins.taboragency.com

# --- Canonical site URL (optional override) ----------------------------------
# Defaults to BRAND.url (https://taboragency.com). Only set to override.
# NEXT_PUBLIC_SITE_URL=https://taboragency.com

# The lead proxy requires Vercel's server-provided VERCEL=1 and a valid single
# x-vercel-forwarded-for header. Do not simulate these on another host.
# Local behavioral runner only: LEAD_PROXY_TEST_MODE=loopback, with a loopback
# HTTP upstream and the synthetic check-lead-proxy-test-key. Never set on hosting.
