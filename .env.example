# --- Lead intake (server-only) ---------------------------------------------
# Shared key for the /api/quote proxy that forwards leads to the agency
# platform's public lead-intake endpoint.
# Never put a real value here: this repo is public. Production's value lives only
# in the Vercel project env (Production, sensitive) and on ins-platform. Leave it
# blank locally and the proxy fails closed with its honest 502 (the safe default).
LEAD_INTAKE_KEY=

# --- Client portal -----------------------------------------------------------
# Base URL of the agency platform's client portal. The site appends
# /portal/login and /portal/request-access to this value.
# Local-dev fallback (platform tunnel):
NEXT_PUBLIC_PORTAL_URL=https://ins.jahdev.com
# Production (already set on the Vercel project; portal.taboragency.com is live):
# NEXT_PUBLIC_PORTAL_URL=https://portal.taboragency.com

# --- Canonical site URL (optional override) ----------------------------------
# Defaults to BRAND.url (https://taboragency.com). Only set to override.
# NEXT_PUBLIC_SITE_URL=https://taboragency.com
